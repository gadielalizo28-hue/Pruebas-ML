import torch
import numpy as np

#indexacion y sliging(selecciona lo que necesites): usas corchetes y dos puntos para extraer lo que necesitas

#formato: tensor[fila_inicio:fila_fin, columna_inicio:columna_fin]
#los dos puntos indican que traer de tal dimension, los indices negativos sirven para contar desde el final hacia
#atras(el ultimo elemento es -1).

#codigos:

#tensor[indice] o tensor[:, columna]: selecciona una fila/columna

#tensor[inicio:fin] toma un pedazo continuo(el indice fin no se incluye)

#tensor.reshape(nuevo_shape) cambia la geometria sin perder elementos

#tensor.permute(ejes...) Girar ejes, cambia de orden las dimensiones (vital para imagenes)

# Creamos una matriz de 4 filas y 3 columnas con números secuenciales del 0 al 11
matriz_base = torch.arange(12).reshape(4, 3)
print("Matriz original (4x3):\n", matriz_base)
#creamos una matriz con arange y usamos un reshape para ordenar en 4x3

# 1. Slicing: Obtener la fila 2 completa
print("\nFila 2:", matriz_base[2]) #lo que importa aqui es el 2 entre rectos

# Slicing: Obtener la última columna completa de todas las filas
print("Última columna:\n", matriz_base[:, 2]) #dejamos vacia el area de filas

# 2. Reshape: Cambiar la forma de la matriz de 4x3 a un cubo de 2x2x3
cubo_nuevo = matriz_base.reshape(2, 2, 3)
print("\nTransformado a cubo (2x2x3):\n", cubo_nuevo)



# TUS DATOS: 4 servidores, 3 métricas cada uno
mis_servidores = torch.tensor([
    [15.5, 60.2, 45.0],  # Servidor 0
    [88.9, 95.1, 82.3],  # Servidor 1 (¡Alerta, sobrecalentado!)
    [42.0, 50.0, 55.4],  # Servidor 2
    [9.1,  30.4, 40.0]   # Servidor 3
], dtype=torch.float32)

print("--- TUS DATOS REALES (Servidores) ---")
print(mis_servidores)

# 1. SLICING: Queremos auditar únicamente la métrica de 'Temperatura' (que está en la última columna, índice 2)
temperaturas = mis_servidores[:, 2]
print("\nTemperaturas de todos los servidores:", temperaturas)

# 2. SLICING AVANZADO: Queremos ver el estado completo de los servidores críticos (filas 1 y 2)
servidores_criticos = mis_servidores[1:3, :]
print("\nEstado de los servidores 1 y 2:\n", servidores_criticos)

# 3. RESHAPE: Imagina que quieres reagrupar estos datos para un formato de lote de análisis de 2x2x3
# (Asegurándonos de que el número total de elementos coincida: 4 * 3 = 12)
reagrupado = mis_servidores.reshape(2, 2, 3)
print("\nTus datos con nueva geometría (2x2x3):\n", reagrupado)

